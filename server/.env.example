# Server Configuration
PORT=5000
NODE_ENV=production

# Client Application URL (for CORS and Secure Cookie transmission)
# e.g., https://your-app.vercel.app or https://your-app.pages.dev
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/privacy_finance?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/privacy_finance

# JWT Signing Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=40f3373f8c18da1e6612ba1aac113df2d0578dd55f88ff1ae1c5682cd5fac1ac
JWT_REFRESH_SECRET=1fd7fbd482b8d1d37899439c819c34095f2149c914e76745e7f636ade901c826

# LLM Bank Statement Parsing Provider
# Supported options: "gemini" | "openai-compatible" | "mock"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_or_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: LLM_BASE_URL (for custom OpenAI-compatible proxies)
# LLM_BASE_URL=https://api.openai.com/v1

